# ----------------------------- HELPERS -----------------------------
def angular_separation(ra1: float, dec1: float, ra2: float, dec2: float) -> float:
    """Distance angulaire en degrés, avec gestion correcte du passage RA 0/360."""
    r1, d1, r2, d2 = map(math.radians, (ra1, dec1, ra2, dec2))
    dra = (r2 - r1 + math.pi) % (2 * math.pi) - math.pi
    a = math.sin((d2 - d1) / 2) ** 2 + math.cos(d1) * math.cos(d2) * math.sin(dra / 2) ** 2
    return math.degrees(2 * math.asin(math.sqrt(max(0.0, min(1.0, a)))))


def safe_float(value: Any, default: float | None = None) -> float | None:
    try:
        result = float(value)
        return result if math.isfinite(result) else default
    except (TypeError, ValueError):
        return default


def query_spherex(ra: float, dec: float, radius: float, limit: int = 100) -> list[dict]:
    """
    Interroge le service SIA d'IRSA autour d'une position céleste.
    La réponse VOTable est lue par Astropy. Les noms de colonnes varient
    parfois selon le produit/catalogue : on teste plusieurs alias.
    """
    params = {
        "POS": f"CIRCLE {ra:.8f} {dec:.8f} {radius:.8f}",
        "SIZE": f"{radius * 2:.8f}",
        "FORMAT": "image/fits",
    }
    response = requests.get(IRSA_SIA_URL, params=params, timeout=REQUEST_TIMEOUT)
    response.raise_for_status()

    from astropy.io.votable import parse_single_table
    table = parse_single_table(io.BytesIO(response.content)).to_table(use_names_over_ids=True)

    rows: list[dict] = []
    for row in table[:limit]:
        item = {str(name).lower(): row[name] for name in table.colnames}

        def first(*names):
            for name in names:
                if name.lower() in item:
                    value = item[name.lower()]
                    if np.ma.is_masked(value):
                        continue
                    if isinstance(value, bytes):
                        value = value.decode("utf-8", "ignore")
                    text_value = str(value).strip()
                    if text_value and text_value.lower() not in {"--", "none", "masked"}:
                        return text_value
            return None

        url = first("access_url", "access_reference", "url", "accessurl")
        if not url:
            continue
        rows.append({
            "url": url,
            "title": first("obs_title", "target_name", "obs_id", "dataproduct_subtype") or "Observation SPHEREx",
            "date": first(" t_min", "t_min", "date_obs", "obs_date", "mjd_obs") or "Date non fournie",
            "band": first("energy_band", "em_band", "filter", "band", "spectral_band") or "Non précisée",
            "ra": safe_float(first("s_ra", "ra", "s_ra_c")),
            "dec": safe_float(first("s_dec", "dec", "s_dec_c")),
            "format": first(" access_format", "access_format") or "image/fits",
        })
    return rows


def download_fits(url: str) -> fits.HDUList:
    """Télécharge un FITS depuis l'URL fournie par les métadonnées IRSA."""
    if not url.startswith(("https://", "http://")):
        raise ValueError("URL d'observation invalide.")
    response = requests.get(url, timeout=REQUEST_TIMEOUT)
    response.raise_for_status()
    return fits.open(io.BytesIO(response.content), memmap=False)


def find_image_hdu(hdul: fits.HDUList):
    for hdu in hdul:
        data = getattr(hdu, "data", None)
        if data is not None and np.asarray(data).ndim >= 2:
            arr = np.asarray(data)
            if arr.ndim == 2:
                return hdu
            if arr.ndim == 3:
                # Choix du premier plan si le FITS contient un cube.
                return hdu
    raise ValueError("Aucune image 2D exploitable trouvée dans ce FITS.")


def fits_to_2d(hdul: fits.HDUList) -> tuple[np.ndarray, WCS | None, fits.Header]:
    hdu = find_image_hdu(hdul)
    data = np.asarray(hdu.data, dtype=np.float32)
    while data.ndim > 2:
        data = data[0]
    data = np.squeeze(data)
    if data.ndim != 2:
        raise ValueError("Le tableau FITS n'est pas une image 2D.")
    data = np.where(np.isfinite(data), data, np.nan)
    wcs = None
    try:
        candidate = WCS(hdu.header)
        if candidate.has_celestial:
            wcs = candidate.celestial
    except Exception:
        pass
    return data, wcs, hdu.header


def stretch_image(data: np.ndarray) -> np.ndarray:
    """Étirement percentile robuste pour afficher une image astronomique."""
    finite = data[np.isfinite(data)]
    if finite.size == 0:
        return np.zeros(data.shape, dtype=np.uint8)
    lo, hi = np.nanpercentile(finite, [1, 99])
    if not np.isfinite(lo) or not np.isfinite(hi) or hi <= lo:
        lo, hi = np.nanmin(finite), np.nanmax(finite) + 1e-6
    scaled = np.clip((data - lo) / (hi - lo), 0, 1)
    scaled = np.nan_to_num(scaled, nan=0.0)
    # Asinh donne un rendu plus lisible des sources faibles et fortes.
    scaled = np.arcsinh(10 * scaled) / np.arcsinh(10)
    return (scaled * 255).astype(np.uint8)


def align_second_to_first(
    image1: np.ndarray, wcs1: WCS | None,
    image2: np.ndarray, wcs2: WCS | None,
) -> tuple[np.ndarray, np.ndarray]:
    """
    Aligne l'image 2 sur la grille pixel de l'image 1 si les deux WCS
    célestes sont disponibles. Sinon, refuse une soustraction trompeuse.
    """
    if wcs1 is None or wcs2 is None:
        raise ValueError(
            "Les métadonnées WCS célestes manquent dans au moins un FITS. "
            "Impossible de garantir un alignement astronomique fiable."
        )
    try:
        from reproject import reproject_interp
    except ImportError as exc:
        raise ImportError("Le paquet 'reproject' manque. Installe-le avec pip install reproject.") from exc
    aligned, footprint = reproject_interp(
        (image2, wcs2), wcs1, shape_out=image1.shape, order="bilinear"
    )
    valid = (footprint > 0) & np.isfinite(image1) & np.isfinite(aligned)
    return aligned.astype(np.float32), valid


def make_difference(image1: np.ndarray, image2_aligned: np.ndarray, valid: np.ndarray):
    """Soustraction scientifique simple : image 2 alignée moins image 1."""
    difference = np.full(image1.shape, np.nan, dtype=np.float32)
    difference[valid] = image2_aligned[valid] - image1[valid]
    return difference


