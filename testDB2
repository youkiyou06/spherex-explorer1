# =====================================================================
if __name__ == "__main__":
    # Exemple sur l'écliptique (zone de passage des planètes et astéroïdes)
    RA_CIBLE = 180.0
    DEC_CIBLE = 0.0
    
    # On demande un écart minimum de 0.1 jour (~2h20), suffisant pour voir un astéroïde bouger
    fichiers = telecharger_images_mouvement(
        ra_deg=RA_CIBLE,
        dec_deg=DEC_CIBLE,
        taille_deg=0.08,
        ecart_jours_min=0.1
    )
    
    if len(fichiers) == 2:
        print("\nSuccès ! Voici les 2 fichiers à passer à votre fonction de différence :")
        print("Image 1 :", fichiers[0])
        print("Image 2 :", fichiers[1])
