def load_observations():
    if not JSON_FILE.exists():
        return []

    try:
        with open(JSON_FILE, "r", encoding="utf-8") as file:
            data = json.load(file)

        return data.get("observations", [])

    except Exception as error:
        st.error(f"Unable to read observations.json: {error}")
        return []


def angular_distance(ra1, dec1, ra2, dec2):
    """Calculate angular distance between two celestial positions."""

    ra1 = math.radians(ra1)
    dec1 = math.radians(dec1)
    ra2 = math.radians(ra2)
    dec2 = math.radians(dec2)

    cos_angle = (
        math.sin(dec1) * math.sin(dec2)
        + math.cos(dec1)
        * math.cos(dec2)
        * math.cos(ra1 - ra2)
    )

    cos_angle = max(-1, min(1, cos_angle))

    return math.degrees(math.acos(cos_angle))


def search_observations(ra, dec, radius):
    observations = load_observations()
    results = []

    for obs in observations:
        try:
            distance = angular_distance(
                ra,
                dec,
                float(obs["ra_deg"]),
                float(obs["dec_deg"])
            )

            if distance <= radius:
                result = obs.copy()
                result["distance"] = distance
                results.append(result)

        except (KeyError, ValueError, TypeError):
            continue

    return sorted(results, key=lambda item: item.get("date", ""))


