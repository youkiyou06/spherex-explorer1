import matplotlib.pyplot as plt
from astroquery.ipac.irsa import Irsa
from astropy.coordinates import SkyCoord
import astropy.units as u
from astropy.io import fits
import numpy as np
import requests
from io import BytesIO

# 1. ON CHOISIT LE MEME ENDROIT DU CIEL
endroit = SkyCoord(ra=10, dec=41, unit='deg')  # tu peux changer les coordonnées

print("Je cherche les 2 images...")
# 2. ON CHERCHE IMAGE 1 = DR1 et IMAGE 2 = QR3
tab1 = Irsa.query_sia(pos=(endroit, 1*u.deg), collection='spherex_dr1')
tab2 = Irsa.query_sia(pos=(endroit, 1*u.deg), collection='spherex_qr3')

url1 = tab1[0]['access_url']
url2 = tab2[0]['access_url']
print(f"Image 1 trouvée : {url1}")
print(f"Image 2 trouvée : {url2}")

# 3. FONCTION POUR AFFICHER UN FITS DEPUIS UN LIEN SANS LE SAUVER
def afficher_fits(url, titre):
    # on télécharge en mémoire
    r = requests.get(url)
    f = fits.open(BytesIO(r.content))
    # l'image est dans le 1er ou 2e morceau, on teste
    try:
        img = f[1].data
    except:
        img = f[0].data
    
    plt.figure()
    plt.imshow(img, cmap='gray', vmin=np.percentile(img, 5), vmax=np.percentile(img, 99.5), origin='lower')
    plt.colorbar(label='Valeur du pixel')
    plt.title(titre)
    plt.show()
    return img

# 4. ON AFFICHE LES 2 IMAGES
print("Affichage produit 1...")
img1 = afficher_fits(url1, "Produit SPHEREx 1 - DR1 (Janvier)")

print("Affichage produit 2...")
img2 = afficher_fits(url2, "Produit SPHEREx 2 - QR3 (Juillet)")

# 5. LA SOUSTRACTION - LE TRUC QUI TROUVE PLANET X
print("Je fais la soustraction...")
# on s'assure qu'elles ont la même taille
if img1.shape != img2.shape:
    # on coupe à la plus petite taille
    h = min(img1.shape[0], img2.shape[0])
    w = min(img1.shape[1], img2.shape[1])
    img1 = img1[:h, :w]
    img2 = img2[:h, :w]

diff = img2.astype(float) - img1.astype(float)

plt.figure()
plt.imshow(diff, cmap='seismic', vmin=-3*np.std(diff), vmax=3*np.std(diff), origin='lower')
plt.colorbar(label='Différence')
plt.title("SOUSTRACTION : Photo2 - Photo1 = Ce qui a bougé")
plt.show()

# 6. ON TROUVE LES POINTS QUI ONT BOUGÉ
seuil = 5 * np.std(diff)
y, x = np.where(np.abs(diff) > seuil)
print(f"J'ai trouvé {len(x)} points qui ont bougé !")
print(f"Positions : {list(zip(x[:10], y[:10]))}") # affiche les 10 premiers

# Sauve pour tes potes visuels
np.savetxt("moving_objects.csv", np.column_stack((x,y)), delimiter=",", header="x,y")
print("Fichier moving_objects.csv créé pour Lisandre et Yukyan")
