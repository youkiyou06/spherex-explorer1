        try:
            with st.spinner("Téléchargement et lecture…"):
                fits_path = cached_download(selected_record)
                image, _wcs = read_fits_image(fits_path)
                png_bytes = make_png(image, observation_label(selected_record))
                st.session_state["current_image_png"] = png_bytes
                st.session_state["current_image_label"] = observation_label(selected_record)
                st.session_state["current_image_url"] = selected_record["access_url"]
        except Exception as error:
            st.error(f"Impossible de charger : {error}")
    if st.session_state.get("current_image_png") is not None and st.session_state.get("current_image_url") == selected_record.get("access_url"):
        st.image(st.session_state["current_image_png"], caption=st.session_state["current_image_label"], use_container_width=True)
    with st.expander("Métadonnées"):
        st.json(dict(selected_record))
    st.subheader("4. Comparateur clignotant")
    blink_comparator(band_records)
    st.subheader("5. Comparer deux époques")
    if len(band_records) < 2:
        st.info("Il faut au moins deux observations.")
        return
    col_first, col_second = st.columns(2)
    with col_first:
        first_index = st.selectbox("Référence", options=list(range(len(band_records))), index=0, format_func=lambda index: observation_label(band_records[index]), key="compare_reference")
    with col_second:
        second_index = st.selectbox("À comparer", options=list(range(len(band_records))), index=min(1, len(band_records) - 1), format_func=lambda index: observation_label(band_records[index]), key="compare_later")
    threshold = st.slider("Seuil σ", min_value=2.0, max_value=10.0, value=5.0, step=0.5)
    if st.button("Aligner et comparer", type="primary", use_container_width=True):
        if first_index == second_index:
            st.warning("Choisis deux observations différentes.")
        else:
            try:
                with st.spinner("Alignement WCS…"):
                    result = compare_fits(band_records[first_index], band_records[second_index], threshold_sigma=float(threshold))
                st.session_state.comparison_result = result
                st.session_state.comparison_labels = (observation_label(band_records[first_index]), observation_label(band_records[second_index]))
            except Exception as error:
                st.session_state.comparison_result = None
                st.error(f"Comparaison échouée : {error}")
    result = st.session_state.get("comparison_result")
    if result is not None:
        labels = st.session_state.get("comparison_labels", ("", ""))
        st.caption(f"Référence : {labels[0]} · Comparée : {labels[1]}")
        m1, m2, m3 = st.columns(3)
        m1.metric("Pixels valides", result["valid_pixel_count"])
        m2.metric("Dispersion", f"{result['robust_sigma']:.4g}")
        m3.metric("Candidats", len(result["candidates"]))
        difference = result["difference"]
        finite = np.isfinite(difference)
        if finite.any():
            max_display = float(np.nanpercentile(np.abs(difference[finite]), 99))
            if not np.isfinite(max_display) or max_display <= 0:
                max_display = 1.0
            figure, axis = plt.subplots(figsize=(9, 6))
            try:
                image_plot = axis.imshow(difference, origin="lower", cmap="RdBu_r", vmin=-max_display, vmax=max_display, interpolation="nearest")
                axis.set_title("Image comparée − référence")
                axis.set_xlabel("Pixel X")
                axis.set_ylabel("Pixel Y")
                figure.colorbar(image_plot, ax=axis, label="Différence")
                figure.tight_layout()
                st.pyplot(figure, use_container_width=True)
            finally:
                plt.close(figure)
        if result["candidates"]:
            st.dataframe(result["candidates"], use_container_width=True, hide_index=True)
        st.warning("Résultats exploratoires. Un pixel candidat n'est pas une détection confirmée.")

