def init_database() -> None:
    with sqlite3.connect(DATABASE_PATH) as connection:
        connection.execute(
            """
            CREATE TABLE IF NOT EXISTS observations (
                observation_id TEXT PRIMARY KEY,
                collection TEXT,
                epoch TEXT,
                band TEXT,
                access_url TEXT NOT NULL,
                metadata_json TEXT NOT NULL,
                saved_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
            )
            """
        )
        connection.commit()

def plain_value(value: Any) -> Any:
    if value is None:
        return None
    try:
        if np.ma.is_masked(value):
            return None
    except (TypeError, ValueError):
        pass
    if isinstance(value, np.generic):
        value = value.item()
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace").strip()
    if isinstance(value, float) and not np.isfinite(value):
        return None
    if isinstance(value, (str, int, float, bool)):
        return value
    return str(value)

def get_field(record: Mapping[str, Any], *names: str) -> Any:
    lowered = {str(key).lower(): value for key, value in record.items()}
    for name in names:
        value = lowered.get(name.lower())
        if value is None:
            continue
        text = str(value).strip().lower()
        if text not in {"", "--", "nan", "none", "masked"}:
            return value
    return None

def get_band(record: Mapping[str, Any]) -> str:
    value = get_field(record, "band_value", "energy_bandpassname", "band", "filter", "filter_name", "bandpass", "bandnum")
    return str(value) if value is not None else "Bande inconnue"

def get_epoch(record: Mapping[str, Any]) -> str:
    value = get_field(record, "epoch", "mjd", "mjd_obs", "t_min", "time", "date_obs", "obs_date")
    return str(value) if value is not None else "Époque inconnue"

def sort_key(record: Mapping[str, Any]) -> tuple[int, float | str, str]:
    value = get_field(record, "mjd", "mjd_obs", "t_min", "epoch")
    try:
        if value is not None:
            return (0, float(value), str(record.get("observation_id", "")))
    except (TypeError, ValueError):
        pass
    return (1, get_epoch(record), str(record.get("observation_id", "")))

def observation_label(record: Mapping[str, Any]) -> str:
    identifier = get_field(record, "observation_id", "obs_id", "obsid", "dp_id") or "Observation"
    return f"{get_epoch(record)} · {get_band(record)} · {identifier}"

def save_observations(records: Sequence[Mapping[str, Any]]) -> int:
    count = 0
    with sqlite3.connect(DATABASE_PATH) as connection:
        for record in records:
            url = str(record.get("access_url") or "").strip()
            if not url:
                continue
            identifier = str(record.get("observation_id") or hashlib.sha256(url.encode("utf-8")).hexdigest())
            metadata = json.dumps(dict(record), ensure_ascii=False, default=str)
            connection.execute(
                """
                INSERT INTO observations (observation_id, collection, epoch, band, access_url, metadata_json)
                VALUES (?, ?, ?, ?, ?, ?)
                ON CONFLICT(observation_id) DO UPDATE SET
                    collection = excluded.collection,
                    epoch = excluded.epoch,
                    band = excluded.band,
                    access_url = excluded.access_url,
                    metadata_json = excluded.metadata_json,
                    saved_at = CURRENT_TIMESTAMP
                """,
                (identifier, str(record.get("collection") or ""), get_epoch(record), get_band(record), url, metadata),
            )
            count += 1
        connection.commit()
    return count

def database_count() -> int:
    with sqlite3.connect(DATABASE_PATH) as connection:
        result = connection.execute("SELECT COUNT(*) FROM observations").fetchone()
        return int(result[0]) if result else 0

def search_irsa(ra_deg: float, dec_deg: float, radius_deg: float, collections: Sequence[str], limit: int) -> list[dict[str, Any]]:
    ra_deg = float(ra_deg)
    dec_deg = float(dec_deg)
    radius_deg = float(radius_deg)
    limit = int(limit)
    if not 0 <= ra_deg < 360:
        raise ValueError("RA 0-360")
    if not -90 <= dec_deg <= 90:
        raise ValueError("Dec -90 +90")
    if not 0 < radius_deg <= 10:
        raise ValueError("Rayon 0-10")
    if not collections:
        raise ValueError("Collection vide")
    if limit < 1:
        raise ValueError("Limite positive")
    position = SkyCoord(ra=ra_deg * u.deg, dec=dec_deg * u.deg, frame="icrs")
    results: list[dict[str, Any]] = []
    seen_urls: set[str] = set()
    errors: list[str] = []
    for collection in collections:
        try:
            table = Irsa.query_sia(pos=(position, radius_deg * u.deg), collection=collection)
        except Exception as error:
            errors.append(f"{collection}: {error}")
            continue
        url_column = next((name for name in table.colnames if str(name).lower() == "access_url"), None)
        if url_column is None:
            errors.append(f"{collection}: access_url absente")
            continue
        for row in table:
            record = {str(name): plain_value(row[name]) for name in table.colnames}
            url = record.get(url_column)
            if not isinstance(url, str):
                continue
            url = url.strip()
            if urlparse(url).scheme.lower() not in {"http", "https"}:
                continue
            if url in seen_urls:
                continue
            seen_urls.add(url)
            record["access_url"] = url
            record["collection"] = collection
            raw_band = get_field(record, "energy_bandpassname", "band", "filter", "filter_name", "bandpass", "bandnum")
            record["band_value"] = str(raw_band) if raw_band is not None else None
            raw_epoch = get_field(record, "mjd", "mjd_obs", "t_min", "time", "date_obs", "obs_date")
            record["epoch"] = plain_value(raw_epoch)
            raw_identifier = get_field(record, "obs_id", "obsid", "dp_id", "obs_publisher_did")
            record["observation_id"] = str(raw_identifier or hashlib.sha256(url.encode("utf-8")).hexdigest())
            results.append(record)
            if len(results) >= limit:
                break
        if len(results) >= limit:
            break
    if not results and errors:
        raise RuntimeError("IRSA: " + " | ".join(errors[:4]))
    results.sort(key=sort_key)
    return results[:limit]

def check_cache_size():
    total = sum(f.stat().st_size for f in FITS_CACHE_DIR.glob("*.fits*") if f.is_file())
    if total > MAX_CACHE_SIZE:
        files = sorted(FITS_CACHE_DIR.glob("*.fits*"), key=lambda p: p.stat().st_mtime)
        while total > MAX_CACHE_SIZE * 0.8 and files:
            oldest = files.pop(0)
            total -= oldest.stat().st_size
            oldest.unlink(missing_ok=True)

def cached_download(record: Mapping[str, Any]) -> Path:
    url = record.get("access_url")
    if not isinstance(url, str) or urlparse(url).scheme.lower() not in {"http", "https"}:
        raise ValueError("URL invalide")
    digest = hashlib.sha256(url.encode("utf-8")).hexdigest()
    is_gzip = urlparse(url).path.lower().endswith(".fits.gz")
    suffix = ".fits.gz" if is_gzip else ".fits"
    destination = FITS_CACHE_DIR / f"{digest}{suffix}"
    if destination.is_file() and destination.stat().st_size > 0:
        try:
            with fits.open(destination, memmap=False) as hdus:
                hdus.verify("exception")
                if any(hdu.data is not None for hdu in hdus):
                    return destination
        except Exception:
            destination.unlink(missing_ok=True)
    temporary_path: Path | None = None
    try:
        with requests.get(url, stream=True, timeout=(20, 240), headers={"User-Agent": "SPHEREx-Explorer/1.0"}, verify=True) as response:
            response.raise_for_status()
            content_length = int(response.headers.get("content-length", 0))
            if content_length > MAX_FITS_SIZE:
                raise ValueError("FITS trop gros")
            check_cache_size()
            with tempfile.NamedTemporaryFile(dir=FITS_CACHE_DIR, suffix=".download", delete=False) as handle:
                temporary_path = Path(handle.name)
                downloaded = 0
                for chunk in response.iter_content(chunk_size=1024 * 1024):
                    if chunk:
                        downloaded += len(chunk)
                        if downloaded > MAX_FITS_SIZE:
                            raise ValueError("FITS dépasse limite")
                        handle.write(chunk)
        with fits.open(temporary_path, memmap=False) as hdus:
            hdus.verify("exception")
            if not any(hdu.data is not None for hdu in hdus):
                raise ValueError("FITS sans données")
        os.replace(temporary_path, destination)
        temporary_path = None
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)
    return destination

def read_fits_image(path: str | Path) -> tuple[np.ndarray, WCS]:
    with fits.open(path, memmap=False) as hdus:
        candidates = sorted(enumerate(hdus), key=lambda item: item[1].name.upper() != "IMAGE")
        for _index, hdu in candidates:
            data = hdu.data
            if data is None or np.ndim(data) != 2:
                continue
            if not np.issubdtype(np.asarray(data).dtype, np.number):
                continue
            try:
                wcs = WCS(hdu.header).celestial
                if not wcs.has_celestial:
                    continue
            except Exception:
                continue
            image = np.array(data, dtype=np.float32, copy=True)
            image[~np.isfinite(image)] = np.nan
            if np.isfinite(image).any():
                return image, wcs
    raise ValueError("Aucune image FITS 2D")

def stretch_image(image: np.ndarray) -> np.ndarray:
    image = np.asarray(image, dtype=np.float32)
    finite = np.isfinite(image)
    if not finite.any():
        raise ValueError("Image sans pixel fini")
    low, high = np.nanpercentile(image[finite], [1, 99])
    if not np.isfinite(low) or not np.isfinite(high) or high <= low:
        low = float(np.nanmin(image[finite]))
        high = float(np.nanmax(image[finite]))
        if high <= low:
            high = low + 1.0
    normalized = np.clip((image - low) / (high - low), 0.0, 1.0)
    return np.nan_to_num(normalized, nan=0.0, posinf=1.0, neginf=0.0)

def make_png(image: np.ndarray, title: str) -> bytes:
    normalized = stretch_image(image)
    figure, axis = plt.subplots(figsize=(5, 5), dpi=100)
    try:
        axis.imshow(normalized, cmap="gray", origin="lower", interpolation="nearest")
        axis.set_title(title, fontsize=9)
        axis.set_axis_off()
        figure.tight_layout(pad=0.5)
        from io import BytesIO
        output = BytesIO()
        figure.savefig(output, format="png", bbox_inches="tight")
        return output.getvalue()
    finally:
        plt.close(figure)

def compare_fits(reference_record: Mapping[str, Any], comparison_record: Mapping[str, Any], threshold_sigma: float) -> dict[str, Any]:
    if reference_record.get("access_url") == comparison_record.get("access_url"):
        raise ValueError("Deux observations différentes requises")
    first_band = get_band(reference_record)
    second_band = get_band(comparison_record)
    if first_band != "Bande inconnue" and second_band != "Bande inconnue" and first_band.casefold() != second_band.casefold():
        raise ValueError(f"Bandes différentes {first_band} / {second_band}")
    first_path = cached_download(reference_record)
    second_path = cached_download(comparison_record)
    reference, reference_wcs = read_fits_image(first_path)
    comparison, comparison_wcs = read_fits_image(second_path)
    aligned, footprint = reproject_interp((comparison, comparison_wcs), reference_wcs, shape_out=reference.shape, return_footprint=True)
    valid = np.isfinite(reference) & np.isfinite(aligned) & np.isfinite(footprint) & (footprint > 0.5)
    if not valid.any():
        raise ValueError("Pas de couverture commune")
    difference = np.full(reference.shape, np.nan, dtype=np.float32)
    difference[valid] = aligned[valid] - reference[valid]
    median_offset = float(np.nanmedian(difference[valid]))
    residual = difference[valid] - median_offset
    robust_sigma = float(1.4826 * np.nanmedian(np.abs(residual)))
    candidate_rows = []
    if np.isfinite(robust_sigma) and robust_sigma > 0:
        significance = np.full(reference.shape, np.nan, dtype=np.float32)
        significance[valid] = (difference[valid] - median_offset) / robust_sigma
        candidate_y, candidate_x = np.where(valid & (np.abs(significance) >= threshold_sigma))
        candidate_rows = [{"x": int(x), "y": int(y), "différence_pixel": float(difference[y, x]), "significativité_sigma": float(significance[y, x])} for y, x in zip(candidate_y, candidate_x)]
        candidate_rows.sort(key=lambda row: abs(row["significativité_sigma"]), reverse=True)
    return {"difference": difference, "valid_pixel_count": int(np.count_nonzero(valid)), "median_offset": median_offset, "robust_sigma": robust_sigma, "candidates": candidate_rows[:200], "total_candidates": len(candidate_rows)}

def blink_comparator(records: Sequence[Mapping[str, Any]]) -> None:
    if len(records) < 2:
        st.info("Il faut au moins deux observations")
        return
    max_frames = min(12, len(records))
    frame_count = st.slider("Nombre d'images", min_value=2, max_value=max_frames, value=min(6, max_frames), key=f"blink_{hash(str(records[0].get('observation_id')))}")
    if len(records) > frame_count:
        indexes = np.linspace(0, len(records) - 1, num=frame_count, dtype=int)
        selected_records = [records[index] for index in np.unique(indexes)]
    else:
        selected_records = list(records)
    if not st.button("Créer / actualiser le comparateur", use_container_width=True):
        return
    png_frames: list[tuple[str, str]] = []
    progress = st.progress(0)
    status = st.empty()
    try:
        for index, record in enumerate(selected_records):
            status.write(f"Chargement {index + 1}/{len(selected_records)} — {observation_label(record)}")
            path = cached_download(record)
            image, _wcs = read_fits_image(path)
            png = make_png(image, observation_label(record))
            encoded = base64.b64encode(png).decode("ascii")
            png_frames.append((f"data:image/png;base64,{encoded}", observation_label(record)))
            progress.progress((index + 1) / len(selected_records))
    except Exception as error:
        st.error(f"Impossible de créer le comparateur : {error}")
        return
    finally:
        progress.empty()
        status.empty()
    if len(png_frames) < 2:
        st.warning("Moins de deux images valides")
        return
    image_json = json.dumps([{"src": src, "label": label} for src, label in png_frames], ensure_ascii=False)
    html_document = f"""
    <!doctype html>
    <html lang="fr">
    <head><meta charset="utf-8"><style>body{{margin:0;padding:14px;color:white;background:#07152f;font-family:Arial;text-align:center}}img{{max-width:100%;max-height:520px;object-fit:contain;border:1px solid #344b70;border-radius:10px}}button{{margin:8px;padding:9px 16px;border:0;border-radius:8px;background:#e8c547;color:#07152f;font-weight:bold;cursor:pointer}}input{{width:min(80%,600px)}}#label{{min-height:22px;margin:8px}}</style></head>
    <body><div id="label"></div><img id="frame"><div><button id="play">▶ Démarrer</button><button id="previous">← Précédente</button><button id="next">Suivante →</button></div><input id="position" type="range" min="0" max="{len(png_frames) - 1}" value="0">
    <script>
    const frames = {image_json};
    const image = document.getElementById("frame"); const label = document.getElementById("label"); const slider = document.getElementById("position"); const playButton = document.getElementById("play");
    let index = 0; let timer = null;
    function showFrame(value){{index = (value + frames.length) % frames.length; image.src = frames[index].src; label.textContent = (index + 1) + "/" + frames.length + " — " + frames[index].label; slider.value = index;}}
    function stop(){{if(timer !== null){{clearInterval(timer); timer = null;}} playButton.textContent = "▶ Démarrer";}}
    playButton.onclick = () => {{if(timer !== null){{stop();}} else {{playButton.textContent = "⏸ Pause"; timer = setInterval(() => showFrame(index + 1), 700);}}}};
    document.getElementById("previous").onclick = () => showFrame(index - 1); document.getElementById("next").onclick = () => showFrame(index + 1); slider.oninput = () => showFrame(Number(slider.value)); showFrame(0);
    </script></body></html>
    """
    components.html(html_document, height=700, scrolling=False)

