                min_value=-90.0,
                max_value=90.0,
                value=20.0,
                format="%.6f"
            )

        radius = st.number_input(
            "Search radius (degrees)",
            min_value=0.001,
            max_value=180.0,
            value=0.1,
            step=0.01,
            format="%.3f"
        )

        search = st.form_submit_button(
            "🚀 SEARCH OBSERVATIONS",
            use_container_width=True
        )

    if search:

        st.session_state.search_done = False
        st.session_state.observations = []
        st.session_state.timeline_index = 0

        try:

            with st.spinner("Searching local observations..."):

                observations = search_observations(
                    ra % 360,
                    dec,
                    radius
                )

            st.session_state.observations = observations
            st.session_state.search_done = True

        except Exception as error:

            st.error(f"Search failed: {error}")

    if st.session_state.search_done:

        observations = st.session_state.observations

        st.markdown("---")

        if not observations:

            st.warning(
                "No observations found. "
                "Try increasing the search radius."
            )

        else:

            total = len(observations)

            st.success(
                f"{total} observation(s) found."
            )

            st.caption(
                f"RA: {ra:.5f}° | Dec: {dec:.5f}° | "
                f"Radius: {radius:.3f}°"
            )

            st.markdown("### ⏳ Observation timeline")

            index = st.session_state.timeline_index

            col_previous, col_counter, col_next = st.columns(
                [1, 2, 1]
            )

            with col_previous:

                if st.button(
                    "⬅ Previous",
                    use_container_width=True,
                    disabled=index == 0
                ):

                    st.session_state.timeline_index -= 1

                    if "timeline_slider" in st.session_state:
                        st.session_state.timeline_slider = (
                            st.session_state.timeline_index
                        )

                    st.rerun()

            with col_counter:

                st.markdown(
                    f"<p style='text-align:center;'>"
                    f"Observation {index + 1} / {total}"
                    f"</p>",
                    unsafe_allow_html=True
                )

            with col_next:

                if st.button(
                    "Next ➡",
                    use_container_width=True,
                    disabled=index >= total - 1
                ):

                    st.session_state.timeline_index += 1

                    if "timeline_slider" in st.session_state:
                        st.session_state.timeline_slider = (
                            st.session_state.timeline_index
                        )

                    st.rerun()

            if total > 1:

                selected_index = st.slider(
                    "Move through time",
                    min_value=0,
                    max_value=total - 1,
                    value=st.session_state.timeline_index,
                    key="timeline_slider"
                )

                if selected_index != st.session_state.timeline_index:

                    st.session_state.timeline_index = selected_index
                    st.rerun()

            current = observations[
                st.session_state.timeline_index
            ]

            st.markdown("---")
            st.markdown("### 🔭 Current observation")

            st.markdown(
                f"**Observation date:** "
                f"{current.get('date', 'Unknown')}"
            )

            if current.get("band"):
                st.markdown(
                    f"**Spectral band:** {current['band']}"
                )

            st.caption(
                f"Angular distance: "
                f"{current['distance']:.5f}°"
            )

            st.image(
                str(current["image_path"]),
                caption=(
                    "Observation — "
                    + str(current.get("date", "Unknown"))
                ),
                use_container_width=True
            )


