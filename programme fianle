def load_observations():

    if not DATABASE_FILE.exists():
        return []

    with open(DATABASE_FILE, "r", encoding="utf-8") as file:
        data = json.load(file)

    return data.get("observations", [])


# ============================================================
# 4. DISTANCE ANGULAIRE
# ============================================================

def angular_separation(ra1, dec1, ra2, dec2):

    ra1 = math.radians(ra1)
    dec1 = math.radians(dec1)
    ra2 = math.radians(ra2)
    dec2 = math.radians(dec2)

    delta_ra = ra2 - ra1
    delta_dec = dec2 - dec1

    a = (
        math.sin(delta_dec / 2) ** 2
        + math.cos(dec1)
        * math.cos(dec2)
        * math.sin(delta_ra / 2) ** 2
    )

    a = max(0.0, min(1.0, a))

    return math.degrees(
        2 * math.asin(math.sqrt(a))
    )


# ============================================================
# 5. RECHERCHE LOCALE
# ============================================================

def search_observations(ra, dec, radius):

    all_observations = load_observations()
    matching = []

    for observation in all_observations:

        try:

            image_ra = float(observation["ra_deg"])
            image_dec = float(observation["dec_deg"])

            distance = angular_separation(
                ra, dec,
                image_ra, image_dec
            )

            if distance <= radius:

                image_path = (
                    IMAGES_DIR / observation["filename"]
                ).resolve()

                try:
                    image_path.relative_to(IMAGES_DIR.resolve())
                except ValueError:
                    continue

                if not image_path.is_file():
                    continue

                result = dict(observation)
                result["image_path"] = image_path
                result["distance"] = distance

                matching.append(result)

        except (KeyError, TypeError, ValueError):
            continue

    matching.sort(
        key=lambda item: str(item.get("date", ""))
    )

    return matching


