                    const cosDec = Math.max(
                        0.1,
                        Math.abs(Math.cos(dec * Math.PI / 180))
                    );

                    const raStep = step / cosDec;

                    if (direction === "up") {
                        dec += step;
                    }

                    if (direction === "down") {
                        dec -= step;
                    }

                    if (direction === "left") {
                        ra -= raStep;
                    }

                    if (direction === "right") {
                        ra += raStep;
                    }

                    dec = Math.max(-89.9, Math.min(89.9, dec));
                    ra = ((ra % 360) + 360) % 360;

                    aladin.gotoRaDec(ra, dec);
                    updateCoordinates();
                }

                document.getElementById("up").onclick =
                    () => moveShip("up");

                document.getElementById("down").onclick =
                    () => moveShip("down");

                document.getElementById("left").onclick =
                    () => moveShip("left");

                document.getElementById("right").onclick =
                    () => moveShip("right");

