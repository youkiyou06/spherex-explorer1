def coordinate_search_mode():

    page_header("Coordinate Search")

    st.markdown("""
    Explore observations around a specific position in the sky.

    Enter the celestial coordinates and choose a search radius.
    """)

    st.markdown("### Enter your coordinates")

    with st.form("coordinate_search_form"):

        col1, col2 = st.columns(2)

        with col1:
            ra = st.number_input(
                "Right Ascension (RA) — degrees",
                min_value=0.0,
                max_value=360.0,
                value=180.0,
                step=0.1,
                format="%.4f"
            )

        with col2:
            dec = st.number_input(
                "Declination (DEC) — degrees",
                min_value=-90.0,
                max_value=90.0,
                value=0.0,
                step=0.1,
                format="%.4f"
            )

        radius = st.number_input(
            "Search radius — degrees",
            min_value=0.01,
            max_value=180.0,
            value=5.0,
            step=0.5,
            format="%.2f"
        )

        submitted = st.form_submit_button(
            "SEARCH THE SKY",
            use_container_width=True
        )

    if submitted:

        st.session_state.results = search_observations(
            ra,
            dec,
            radius
        )

        st.session_state.search_done = True
        st.session_state.timeline_index = 0

    if st.session_state.search_done:

        results = st.session_state.results

        st.markdown("---")

        if not results:
            st.warning(
                "No matching images were found in the local observation database. "
                "Try another position or a larger radius."
            )
            return

        st.success(f"{len(results)} observation(s) found!")

        st.markdown("### Observation timeline")

        if len(results) > 1:

            current_index = st.session_state.timeline_index

            col_prev, col_info, col_next = st.columns([1, 3, 1])

            with col_prev:
                if st.button(
                    "PREVIOUS",
                    disabled=current_index == 0,
                    use_container_width=True
                ):
                    st.session_state.timeline_index -= 1
                    st.rerun()

            with col_info:
                st.markdown(
                    f"<p style='text-align:center;'>"
                    f"Observation {current_index + 1} / {len(results)}"
                    f"</p>",
                    unsafe_allow_html=True
                )

            with col_next:
                if st.button(
                    "NEXT",
                    disabled=current_index >= len(results) - 1,
                    use_container_width=True
                ):
                    st.session_state.timeline_index += 1
                    st.rerun()

        index = min(
            st.session_state.timeline_index,
            len(results) - 1
        )

        observation = results[index]

        st.image(
            observation["image_path"],
            use_container_width=True
        )

        st.markdown("### Observation information")

        col1, col2, col3 = st.columns(3)

        with col1:
            st.markdown(
                f"""
                <div class="info-panel">
                    <b>DATE</b><br>
                    {observation.get("date", "Unknown")}
                </div>
                """,
                unsafe_allow_html=True
            )

        with col2:
            st.markdown(
                f"""
                <div class="info-panel">
                    <b>RA / DEC</b><br>
                    {observation.get("ra_deg", "Unknown")}° /
                    {observation.get("dec_deg", "Unknown")}°
                </div>
                """,
                unsafe_allow_html=True
            )

        with col3:
            st.markdown(
                f"""
                <div class="info-panel">
                    <b>ANGULAR DISTANCE</b><br>
                    {observation["distance"]:.3f}°
                </div>
                """,
                unsafe_allow_html=True
            )

        if observation.get("band"):
            st.markdown(f"**Band:** {observation['band']}")


