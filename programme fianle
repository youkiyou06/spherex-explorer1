# ============================================================
# 5. LOAD OBSERVATIONS
# ============================================================

@st.cache_data
def load_observations():

    if not JSON_FILE.exists():
        return []

    try:
        with open(JSON_FILE, "r", encoding="utf-8") as file:
            data = json.load(file)

        observations = data.get("observations", [])

        return [
            obs for obs in observations
            if all(
                key in obs
                for key in ["filename", "ra_deg", "dec_deg", "date"]
            )
        ]

    except (json.JSONDecodeError, OSError):
        return []


# ============================================================
# 6. ANGULAR DISTANCE
# ============================================================

def angular_separation(ra1, dec1, ra2, dec2):

    ra1 = math.radians(float(ra1))
    dec1 = math.radians(float(dec1))
    ra2 = math.radians(float(ra2))
    dec2 = math.radians(float(dec2))

    cos_angle = (
        math.sin(dec1) * math.sin(dec2)
        + math.cos(dec1) * math.cos(dec2)
        * math.cos(ra1 - ra2)
    )

    cos_angle = max(-1.0, min(1.0, cos_angle))

    return math.degrees(math.acos(cos_angle))


# ============================================================
# 7. SEARCH OBSERVATIONS
# ============================================================

def search_observations(ra, dec, radius):

    observations = load_observations()
    results = []

    for obs in observations:

        try:
            distance = angular_separation(
                ra,
                dec,
                obs["ra_deg"],
                obs["dec_deg"]
            )

            if distance <= radius:

                image_path = IMAGES_DIR / obs["filename"]

                if image_path.is_file():

                    result = obs.copy()
                    result["distance"] = distance
                    result["image_path"] = str(image_path)

                    results.append(result)

        except (ValueError, TypeError, KeyError):
            continue

    results.sort(key=lambda item: str(item["date"]))

    return results


