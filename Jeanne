"""SPHEREx service layer for integration with the team's UI and database.

This file intentionally has no Streamlit widgets, terminal prompts, or network
activity at import time. UI code can call search_observations(), download_observation(),
and compare_observations()/compare_timeline(). Results are plain dictionaries,
lists and NumPy arrays; persist the returned observation metadata and comparison
summary through the database adapter defined by the database teammate. No DB
schema is assumed here.

Scientific caveat: difference-image candidates are exploratory, not confirmed
moving objects or evidence of Planet X.
"""
from __future__ import annotations

import hashlib
import os
import tempfile
from pathlib import Path
from typing import Any, Mapping, Sequence
from urllib.parse import urlparse

import numpy as np
import requests
from astropy.coordinates import SkyCoord
from astropy.io import fits
from astropy.table import Table
import astropy.units as u
from astropy.wcs import WCS
from astroquery.ipac.irsa import Irsa
from reproject import reproject_interp

DEFAULT_COLLECTIONS = ("spherex_dr1", "spherex_qr3")
DEFAULT_CACHE_DIR = Path(__file__).resolve().parent / "data"


def _plain(value: Any) -> Any:
    """Convert Astropy/NumPy scalar values into serializable Python values."""
    if np.ma.is_masked(value):
        return None
    if isinstance(value, np.generic):
        value = value.item()
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace").strip()
    if isinstance(value, float) and not np.isfinite(value):
        return None
    if value is None or isinstance(value, (str, int, float, bool)):
        return value
    return str(value)


def _get(record: Mapping[str, Any], *names: str) -> Any:
    fields = {str(key).lower(): value for key, value in record.items()}
    for name in names:
        value = fields.get(name.lower())
        if value is not None and str(value).strip().lower() not in {"", "--", "nan", "none"}:
            return value
    return None


def _sort_key(record: Mapping[str, Any]) -> tuple[int, float | str, str]:
    """Sort by MJD when available; otherwise use the date string."""
    mjd = _get(record, "mjd", "mjd_obs", "t_min")
    try:
        if mjd is not None:
            return (0, float(mjd), str(record.get("observation_id", "")))
    except (TypeError, ValueError):
        pass
    date = _get(record, "time", "date_obs", "obs_date", "t_min")
    return (1, str(date or ""), str(record.get("observation_id", "")))


def search_observations(
    ra_deg: float,
    dec_deg: float,
    radius_deg: float = 1.0,
    collections: Sequence[str] = DEFAULT_COLLECTIONS,
    band: str | None = None,
    limit: int = 100,
) -> list[dict[str, Any]]:
    """Search IRSA SPHEREx collections and return UI/database-friendly records.

    Coordinates/radius are in degrees. ``band`` filters common band/filter
    columns when IRSA provides one. Records retain IRSA metadata and add stable
    ``observation_id``, ``collection``, ``epoch``, and ``band_value`` fields.
    Use observation_id as a DB/upsert key; list positions are not stable IDs.
    """
    ra_deg, dec_deg, radius_deg = float(ra_deg), float(dec_deg), float(radius_deg)
    if not 0 <= ra_deg <= 360:
        raise ValueError("RA must be between 0 and 360 degrees.")
    if not -90 <= dec_deg <= 90:
        raise ValueError("Dec must be between -90 and 90 degrees.")
    if not 0 < radius_deg <= 180:
        raise ValueError("Search radius must be greater than 0 and at most 180 degrees.")
    if int(limit) < 1:
        raise ValueError("limit must be at least 1.")
    if not collections:
        raise ValueError("At least one IRSA collection is required.")

    position = SkyCoord(ra=ra_deg * u.deg, dec=dec_deg * u.deg, frame="icrs")
    records: list[dict[str, Any]] = []
    seen_urls: set[str] = set()
    for collection in collections:
        table = Irsa.query_sia(pos=(position, radius_deg * u.deg), collection=collection)
        url_column = next((name for name in table.colnames if name.lower() == "access_url"), None)
        if url_column is None:
            continue
        for row in table:
            record = {str(name): _plain(row[name]) for name in table.colnames}
            raw_url = record.get(url_column)
            if not isinstance(raw_url, str):
                continue
            url = raw_url.strip()
            if urlparse(url).scheme.lower() not in {"http", "https"} or url in seen_urls:
                continue
            band_value = _get(record, "band", "filter", "filter_name")
            if band and band_value is not None and band.casefold() not in str(band_value).casefold():
                continue
            seen_urls.add(url)
            record["access_url"] = url
            record["collection"] = collection
            record["band_value"] = band_value
            record["epoch"] = _get(record, "mjd", "mjd_obs", "time", "date_obs", "obs_date", "t_min")
            record["observation_id"] = str(
                _get(record, "obs_id", "obsid", "dp_id", "obs_publisher_did")
                or hashlib.sha256(url.encode("utf-8")).hexdigest()
            )
            records.append(record)
            if len(records) >= int(limit):
                break
        if len(records) >= int(limit):
            break
    records.sort(key=_sort_key)
    return records


def download_observation(
    observation: Mapping[str, Any] | str,
    destination: str | Path,
    timeout: tuple[float, float] = (15.0, 180.0),
) -> Path:
    """Download a search result or URL; validate FITS before saving atomically."""
    url = observation if isinstance(observation, str) else observation.get("access_url")
    if not isinstance(url, str) or urlparse(url).scheme.lower() not in {"http", "https"}:
        raise ValueError("Observation has no valid HTTP(S) access_url.")
    path = Path(destination).expanduser().resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary: Path | None = None
    try:
        with requests.get(url, stream=True, timeout=timeout,
                          headers={"User-Agent": "SPHEREx-Explorer/1.0"}) as response:
            response.raise_for_status()
            with tempfile.NamedTemporaryFile(dir=path.parent, suffix=".download", delete=False) as handle:
                temporary = Path(handle.name)
                for chunk in response.iter_content(chunk_size=1024 * 1024):
                    if chunk:
                        handle.write(chunk)
        with fits.open(temporary, memmap=False) as hdus:
            hdus.verify("exception")
            if not any(hdu.data is not None for hdu in hdus):
                raise ValueError("Downloaded FITS file has no data.")
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return path


def cached_download(
    observation: Mapping[str, Any], cache_dir: str | Path = DEFAULT_CACHE_DIR
) -> Path:
    """Download once per URL into a cache (useful when Streamlit reruns)."""
    url = observation.get("access_url")
    if not isinstance(url, str) or not url:
        raise ValueError("Observation is missing access_url.")
    cache = Path(cache_dir).expanduser().resolve()
    path = cache / (hashlib.sha256(url.encode("utf-8")).hexdigest() + ".fits")
    if path.is_file() and path.stat().st_size:
        try:
            with fits.open(path, memmap=False) as hdus:
                hdus.verify("exception")
                if any(hdu.data is not None for hdu in hdus):
                    return path
        except Exception:
            path.unlink(missing_ok=True)
    return download_observation(observation, path)


def read_fits_image(path: str | Path) -> tuple[np.ndarray, WCS]:
    """Read the first numeric 2-D FITS image with a celestial WCS."""
    with fits.open(path, memmap=False) as hdus:
        for hdu in hdus:
            if hdu.data is None or np.ndim(hdu.data) != 2:
                continue
            if not np.issubdtype(hdu.data.dtype, np.number):
                continue
            wcs = WCS(hdu.header).celestial
            if not wcs.has_celestial:
                continue
            image = np.array(hdu.data, dtype=np.float64, copy=True)
            image[~np.isfinite(image)] = np.nan
            return image, wcs
    raise ValueError(f"No usable 2-D celestial image in {path}.")


def compare_images(
    reference_path: str | Path,
    comparison_path: str | Path,
    *,
    threshold_sigma: float = 5.0,
    coverage_threshold: float = 0.5,
    output_dir: str | Path | None = None,
) -> dict[str, Any]:
    """Align comparison to reference and return arrays and candidate records.

    Difference is comparison minus reference. Median offset is removed only for
    significance calculation. Returned arrays can be plotted by the UI; when
    output_dir is set, a difference FITS and candidate CSV are also written.
    """
    if not np.isfinite(threshold_sigma) or threshold_sigma <= 0:
        raise ValueError("threshold_sigma must be positive and finite.")
    if not 0 <= coverage_threshold <= 1:
        raise ValueError("coverage_threshold must be between 0 and 1.")
    reference, reference_wcs = read_fits_image(reference_path)
    comparison, comparison_wcs = read_fits_image(comparison_path)
    aligned, footprint = reproject_interp(
        (comparison, comparison_wcs), reference_wcs,
        shape_out=reference.shape, return_footprint=True,
    )
    valid = (np.isfinite(reference) & np.isfinite(aligned)
             & np.isfinite(footprint) & (footprint > coverage_threshold))
    if not np.any(valid):
        raise ValueError("The images have no overlapping valid sky coverage.")

    difference = np.full(reference.shape, np.nan, dtype=np.float64)
    difference[valid] = aligned[valid] - reference[valid]
    offset = float(np.median(difference[valid]))
    residual = np.full(reference.shape, np.nan, dtype=np.float64)
    residual[valid] = difference[valid] - offset
    sigma = float(1.4826 * np.median(np.abs(residual[valid])))
    significance = np.full(reference.shape, np.nan, dtype=np.float64)
    if np.isfinite(sigma) and sigma > 0:
        significance[valid] = residual[valid] / sigma
        yy, xx = np.where(valid & (np.abs(significance) >= threshold_sigma))
    else:
        # A zero robust scatter cannot support a meaningful sigma threshold.
        yy, xx = np.array([], dtype=int), np.array([], dtype=int)
    candidates = [
        {"x": int(x), "y": int(y), "difference": float(difference[y, x]),
         "significance_sigma": float(significance[y, x])}
        for y, x in zip(yy, xx)
    ]

    artifacts: dict[str, str] = {}
    if output_dir is not None:
        folder = Path(output_dir).expanduser().resolve()
        folder.mkdir(parents=True, exist_ok=True)
        diff_path = folder / "difference.fits"
        fits.PrimaryHDU(data=difference, header=reference_wcs.to_header()).writeto(
            diff_path, overwrite=True
        )
        csv_path = folder / "pixels_candidats.csv"
        Table(rows=candidates, names=("x", "y", "difference", "significance_sigma")).write(
            csv_path, format="ascii.csv", overwrite=True
        )
        artifacts = {"difference_fits": str(diff_path), "candidates_csv": str(csv_path)}

    return {
        "reference": reference, "aligned_comparison": aligned,
        "coverage": footprint, "valid_mask": valid,
        "difference": difference, "residual": residual,
        "significance": significance, "candidates": candidates,
        "median_offset": offset, "robust_sigma": sigma,
        "valid_pixel_count": int(np.count_nonzero(valid)),
        "candidate_count": len(candidates), "threshold_sigma": float(threshold_sigma),
        "artifacts": artifacts,
        "warning": ("Exploratory pixel-level comparison only. Confirm matching band, units, "
                    "calibration, masks, and epochs; candidates are not confirmed sources."),
    }


def compare_observations(
    earlier: Mapping[str, Any],
    later: Mapping[str, Any],
    *,
    cache_dir: str | Path = DEFAULT_CACHE_DIR,
    output_dir: str | Path | None = None,
    threshold_sigma: float = 5.0,
) -> dict[str, Any]:
    """Download/cache and compare two observations selected by the interface."""
    if earlier.get("observation_id") == later.get("observation_id"):
        raise ValueError("Select two different observations.")
    band_a, band_b = earlier.get("band_value"), later.get("band_value")
    if band_a and band_b and str(band_a).casefold() != str(band_b).casefold():
        raise ValueError(f"Different bands cannot be directly compared ({band_a!r}, {band_b!r}).")
    result = compare_images(
        cached_download(earlier, cache_dir), cached_download(later, cache_dir),
        threshold_sigma=threshold_sigma, output_dir=output_dir,
    )
    result["earlier_observation"] = dict(earlier)
    result["later_observation"] = dict(later)
    return result


def compare_timeline(
    observations: Sequence[Mapping[str, Any]],
    *,
    cache_dir: str | Path = DEFAULT_CACHE_DIR,
    output_dir: str | Path | None = None,
    threshold_sigma: float = 5.0,
) -> list[dict[str, Any]]:
    """Compare each adjacent pair of observations after chronological sorting."""
    ordered = sorted(observations, key=_sort_key)
    if len(ordered) < 2:
        raise ValueError("At least two observations are needed.")
    results = []
    for first, second in zip(ordered, ordered[1:]):
        pair_dir = None
        if output_dir is not None:
            pair_key = f"{first.get('observation_id', '')}-{second.get('observation_id', '')}"
            pair_dir = Path(output_dir) / hashlib.sha256(pair_key.encode("utf-8")).hexdigest()[:16]
        results.append(compare_observations(
            first, second, cache_dir=cache_dir,
            output_dir=pair_dir, threshold_sigma=threshold_sigma,
        ))
    return results
