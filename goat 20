# TEMPORAL EXPLORATION
# ============================================================

def temporal_page():

    if st.button("← BACK TO HOME"):

        st.session_state.mode = "home"
        st.rerun()

    st.title("⏳ Temporal exploration")

    st.write(
        "Search the public AWS archive directly. "
        "No IRSA TAP or SIA request is used."
    )

    st.markdown(
        """
        <div class="info-box">
        Every selected FITS file is inspected.
        The application checks its celestial WCS header
        to determine whether it covers your selected coordinates.
        </div>
        """,
        unsafe_allow_html=True
    )

    # CACHE MANAGEMENT

    if st.button("CLEAR LOCAL SEARCH CACHE"):

        for cache_file in CACHE_DIR.glob("search_*.json"):
            cache_file.unlink(missing_ok=True)

        st.session_state.observations = []
        st.session_state.video = None
        st.session_state.search_parameters = None

        st.success("Local search cache cleared.")

    st.subheader("1. Select sky coordinates")

    col1, col2, col3 = st.columns(3)

    with col1:

        ra = st.number_input(
            "Right ascension (degrees)",
            min_value=0.0,
            max_value=360.0,
            value=83.633
        )

    with col2:

        dec = st.number_input(
            "Declination (degrees)",
            min_value=-90.0,
            max_value=90.0,
            value=22.014
        )

    with col3:

        radius = st.number_input(
            "Search radius (degrees)",
            min_value=0.01,
            max_value=2.0,
            value=0.2
        )

    st.subheader("2. Select release")

    release = st.selectbox(
        "Data release",
        ["dr1", "qr3"]
    )

    try:

        periods = get_periods(release)

        if not periods:

            st.error(
                "No planning periods found in AWS."
            )

            return

        selected_periods = st.multiselect(
            "Planning periods",
            periods,
            default=periods
        )

    except Exception as error:

        st.error(
            f"AWS directory access failed: {error}"
        )

        return

    st.info(
        f"{len(selected_periods)} planning period(s) selected. "
        "All FITS files in these periods will be inspected "
        "on the first search."
    )

    st.subheader("3. Search archive")

    if st.button(
        "SEARCH ALL SELECTED FITS FILES",
        use_container_width=True
    ):

        if not selected_periods:

            st.warning(
                "Select at least one planning period."
            )

        else:

            st.session_state.observations = []
            st.session_state.video = None

            parameters = {
                "release": release,
                "periods": sorted(selected_periods),
                "ra": round(float(ra), 6),
                "dec": round(float(dec), 6),
                "radius": round(float(radius), 6)
            }

            try:

                records, total = search_archive(
                    release,
                    selected_periods,
                    ra,
                    dec,
                    radius
                )

                st.session_state.observations = records
                st.session_state.search_parameters = parameters

                st.success(
                    f"{len(records)} observations found "
                    f"among {total} FITS files."
                )

            except Exception as error:

                st.error(
                    f"Archive search failed: {error}"
                )

    records = st.session_state.observations

    current_parameters = {
        "release": release,
        "periods": sorted(selected_periods),
        "ra": round(float(ra), 6),
        "dec": round(float(dec), 6),
        "radius": round(float(radius), 6)
    }

    # Do not reuse results if the user changes coordinates.

    if (
        records
        and st.session_state.search_parameters
        != current_parameters
    ):

        st.warning(
            "The search parameters have changed. "
            "Run a new search before generating a video."
        )

        return

    if records:

        st.subheader("4. Observations")

        table = pd.DataFrame([
            {
                "Date": item["date"],
                "Spectral band": item["band"],
                "FITS file": item["key"].split("/")[-1]
            }
            for item in records
        ])

        st.dataframe(
            table,
            use_container_width=True,
            hide_index=True
        )

        st.subheader("5. Create temporal video")

        max_images = st.slider(
            "Number of images to download",
            min_value=2,
            max_value=min(30, len(records)),
            value=min(10, len(records))
        )

        fps = st.slider(
            "Playback speed",
            min_value=1,
            max_value=5,
            value=2
        )

        if st.button(
            "GENERATE VIDEO",
            use_container_width=True
        ):

            try:

                video = create_video(
                    records[:max_images],
                    ra,
                    dec,
                    radius,
                    fps
                )

                st.session_state.video = video

                st.success(
                    "Video successfully created."
                )

            except Exception as error:

                st.session_state.video = None

                st.error(
                    f"Video generation failed: {error}"
                )

        if st.session_state.video:

            st.subheader("6. Playback")

            st.video(
                st.session_state.video
            )

            st.download_button(
                "DOWNLOAD VIDEO",
                data=st.session_state.video,
                file_name="spherex_temporal_exploration.mp4",
                mime="video/mp4",
                use_container_width=True
            )


