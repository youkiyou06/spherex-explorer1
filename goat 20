@st.cache_resource
def get_fs():

    return s3fs.S3FileSystem(
        anon=True,
        client_kwargs={
            "region_name": REGION
        }
    )


# ============================================================
# LIST PLANNING PERIODS
# ============================================================

@st.cache_data(ttl=3600)
def get_periods(release):

    fs = get_fs()

    root = f"{BUCKET}/{release}/level2"

    directories = fs.ls(
        root,
        detail=False
    )

    periods = []

    for directory in directories:

        name = directory.rstrip("/").split("/")[-1]

        if name:
            periods.append(name)

    return sorted(periods)


# ============================================================
# LIST ALL FITS FILES
# ============================================================

@st.cache_data(ttl=3600)
def list_all_fits(release, selected_periods):

    fs = get_fs()

    all_files = []

    for period in selected_periods:

        prefix = (
            f"{BUCKET}/{release}/level2/{period}"
        )

        files = fs.find(prefix)

        for filename in files:

            if filename.lower().endswith(
                (".fits", ".fits.gz")
            ):

                all_files.append(filename)

    return sorted(set(all_files))


# ============================================================
# DATE EXTRACTION
# ============================================================

def extract_date(header):

    date_keys = [
        "DATE-AVG",
        "DATE-OBS",
        "DATE-BEG",
        "MJD-AVG",
        "MJD-OBS"
    ]

    for key in date_keys:

        if key not in header:
            continue

        try:

            value = header[key]

            if key.startswith("MJD"):

                return Time(
                    float(value),
                    format="mjd"
                ).datetime.isoformat()

            return Time(
                str(value)
            ).datetime.isoformat()

        except Exception:
            continue

    return None


# ============================================================
# INSPECT ONE FITS FILE
# ============================================================

def inspect_fits_file(
    filename,
    ra,
    dec,
    radius
):

    fs = get_fs()

    target = SkyCoord(
        ra=ra * u.deg,
        dec=dec * u.deg,
        frame="icrs"
    )

    try:

        with fs.open(filename, "rb") as remote_file:

            with fits.open(
                remote_file,
                lazy_load_hdus=True,
                memmap=False
            ) as hdul:

                candidates = sorted(
                    list(enumerate(hdul)),
                    key=lambda item: (
                        item[1].name != "IMAGE"
                    )
                )

                for index, hdu in candidates:

                    header = hdu.header

                    if header.get("NAXIS", 0) < 2:
                        continue

                    if (
                        "NAXIS1" not in header
                        or "NAXIS2" not in header
                    ):
                        continue

                    try:

                        wcs = WCS(
                            header
                        ).celestial

                        if not wcs.has_celestial:
                            continue

                        width = int(header["NAXIS1"])
                        height = int(header["NAXIS2"])

                        x, y = wcs.world_to_pixel(target)

                        if (
                            not np.isfinite(x)
                            or not np.isfinite(y)
                        ):
                            continue

                        scales = np.abs(
                            wcs.proj_plane_pixel_scales().to_value(
                                u.deg
                            )
                        )

                        pixel_scale = float(
                            np.mean(scales)
                        )

                        margin = (
                            radius /
                            max(pixel_scale, 1e-8)
                        )

                        if not (
                            -margin <= x <= width + margin
                            and -margin <= y <= height + margin
                        ):
                            continue

                        date = (
                            extract_date(header)
                            or extract_date(hdul[0].header)
                        )

                        if date is None:
                            continue

                        band = (
                            header.get("BANDPASS")
                            or header.get("BAND")
                            or header.get("BANDNUM")
                            or hdul[0].header.get(
                                "BANDPASS",
                                "Unknown"
                            )
                        )

                        return {
                            "key": filename,
                            "date": date,
                            "band": str(band),
                            "hdu": index
                        }

                    except Exception:
                        continue

    except Exception:
        return None

    return None


# ============================================================
# CACHE IDENTIFICATION
# ============================================================

def get_search_cache_path(
    release,
    periods,
    ra,
    dec,
    radius
):

    parameters = {
        "release": release,
        "periods": sorted(periods),
        "ra": round(float(ra), 6),
        "dec": round(float(dec), 6),
        "radius": round(float(radius), 6)
    }

    encoded = json.dumps(
        parameters,
        sort_keys=True
    ).encode("utf-8")

    digest = hashlib.sha256(
        encoded
    ).hexdigest()

    return CACHE_DIR / f"search_{digest}.json"


# ============================================================
# SEARCH ARCHIVE WITH LOCAL CACHE
# ============================================================

def search_archive(
    release,
    periods,
    ra,
    dec,
    radius
):

    cache_file = get_search_cache_path(
        release,
        periods,
        ra,
        dec,
        radius
    )

    # 1. CHECK CACHE

    if cache_file.exists():

        try:

            with open(
                cache_file,
                "r",
                encoding="utf-8"
            ) as file:

                cached = json.load(file)

            st.success(
                "Results loaded from local cache."
            )

            return cached["records"], cached["total"]

        except Exception:

            cache_file.unlink(
                missing_ok=True
            )

    # 2. LIST FILES

    files = list_all_fits(
        release,
        tuple(periods)
    )

    total = len(files)

    if total == 0:
        return [], 0

    # 3. INSPECT FILES

    results = []

    progress = st.progress(0)
    status = st.empty()

    workers = 8
    completed = 0

    with ThreadPoolExecutor(
        max_workers=workers
    ) as executor:

        futures = [
            executor.submit(
                inspect_fits_file,
                filename,
                ra,
                dec,
                radius
            )
            for filename in files
        ]

        for future in as_completed(futures):

            completed += 1

            try:

                result = future.result()

                if result is not None:
                    results.append(result)

            except Exception:
                pass

            if completed % 20 == 0 or completed == total:

                status.write(
                    f"AWS inspection: {completed}/{total} "
                    f"| Observations found: {len(results)}"
                )

                progress.progress(
                    completed / total
                )

    progress.empty()
    status.empty()

    # 4. SORT CHRONOLOGICALLY

    results.sort(
        key=lambda item: item["date"]
    )

    # 5. SAVE CACHE

    cache_data = {
        "records": results,
        "total": total
    }

    temporary_cache = cache_file.with_suffix(".tmp")

    with open(
        temporary_cache,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            cache_data,
            file,
            ensure_ascii=False
        )

    temporary_cache.replace(
        cache_file
    )

    return results, total


# ============================================================
# DOWNLOAD IMAGE
# ============================================================

def download_image(
    record,
    ra,
    dec,
    radius
):

    fs = get_fs()

    target = SkyCoord(
        ra=ra * u.deg,
        dec=dec * u.deg,
        frame="icrs"
    )

    with fs.open(
        record["key"],
        "rb"
    ) as remote_file:

        with fits.open(
            remote_file,
            memmap=False
        ) as hdul:

            hdu = hdul[record["hdu"]]

            data = np.asarray(
                hdu.data,
                dtype=np.float32
            )

            wcs = WCS(
                hdu.header
            ).celestial

            cutout = Cutout2D(
                data,
                position=target,
                size=(
                    radius * 2 * u.deg,
                    radius * 2 * u.deg
                ),
                wcs=wcs,
                mode="partial",
                fill_value=np.nan
            )

            return cutout.data


# ============================================================
# BUILD VIDEO
# ============================================================

def create_video(
    records,
    ra,
    dec,
    radius,
    fps
):

    images = []

    progress = st.progress(0)
    status = st.empty()

    for index, record in enumerate(records):

        status.write(
            f"Downloading image {index + 1}/{len(records)}"
        )

        try:

            image = download_image(
                record,
                ra,
                dec,
                radius
            )

            if not np.isfinite(image).any():
                continue

            images.append({
                "data": image,
                "date": record["date"],
                "band": record["band"]
            })

        except Exception as error:

            st.warning(
                f"Image skipped: {error}"
            )

        progress.progress(
            (index + 1) / len(records)
        )

    progress.empty()
    status.empty()

    if len(images) < 2:

        raise ValueError(
            "At least two usable images are required."
        )

    # COMMON INTENSITY SCALE

    values = np.concatenate([
        item["data"][
            np.isfinite(item["data"])
        ]
        for item in images
    ])

    low, high = np.percentile(
        values,
        [1, 99]
    )

    frames = []

    for item in images:

        data = np.nan_to_num(
            item["data"],
            nan=low,
            posinf=high,
            neginf=low
        )

        normalized = np.clip(
            (data - low) / max(high - low, 1e-8),
            0,
            1
        )

        fig, ax = plt.subplots(
            figsize=(6, 6),
            dpi=100
        )

        ax.imshow(
            normalized,
            cmap="gray",
            origin="lower"
        )

        ax.set_title(
            f"SPHEREx | {item['date']}",
            color="white",
            fontsize=9
        )

        ax.text(
            0.5,
            0.02,
            f"Band: {item['band']}",
            transform=ax.transAxes,
            color="yellow",
            ha="center"
        )

        ax.set_axis_off()

        fig.patch.set_facecolor(
            BACKGROUND
        )

        fig.canvas.draw()

        frame = np.asarray(
            fig.canvas.buffer_rgba()
        )[:, :, :3].copy()

        frames.append(frame)

        plt.close(fig)

    with tempfile.NamedTemporaryFile(
        suffix=".mp4",
        delete=False
    ) as temporary:

        filename = temporary.name

    try:

        imageio.mimsave(
            filename,
            frames,
            fps=fps,
            codec="libx264",
            quality=8
        )

        with open(filename, "rb") as file:
            video = file.read()

    finally:

        Path(filename).unlink(
            missing_ok=True
        )

    return video


