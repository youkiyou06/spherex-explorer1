from astropy.coordinates import SkyCoord, get_sun, get_moon
from astropy.time import Time
import astropy.units as u


def _format_deg(value: float | None) -> str:
    if value is None:
        return "N/A"
    return f"{float(value):.4f}°"


def _format_hms_deg(value_deg: float) -> str:
    # Conversion RA en h m s
    ra_hours = value_deg / 15.0
    h = int(ra_hours)
    m = int((ra_hours - h) * 60)
    s = ((ra_hours - h) * 60 - m) * 60
    return f"{h:02d}h {m:02d}m {s:05.2f}s"


